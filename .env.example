# Copy to .env and fill in. Never commit .env.

# Anthropic API key (console.anthropic.com → API keys)
ANTHROPIC_API_KEY=

# Optional: Claude model (default claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5

# Optional but recommended: verify the Cloudflare Access login on every API call.
# Team domain from Zero Trust → Settings → Custom pages (e.g. yourteam.cloudflareaccess.com)
# and the Application Audience (AUD) tag from the Access application's overview.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Spend guard: max AI requests per hour (all users together)
AI_REQUESTS_PER_HOUR=120
